<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Just For You ❤️</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:Georgia,"Times New Roman",serif;
  color:#fff;
  background:#120611;
  overflow-x:hidden;
}
body:before{
  content:"";position:fixed;inset:0;z-index:-3;
  background:
   radial-gradient(circle at 20% 15%,#8e285f 0,transparent 30%),
   radial-gradient(circle at 80% 70%,#54205e 0,transparent 30%),
   linear-gradient(145deg,#10040f,#26091f 50%,#0c030b);
}
body:after{
 content:"";position:fixed;inset:0;z-index:-2;opacity:.12;
 background-image:radial-gradient(#fff 1px,transparent 1px);
 background-size:35px 35px;
}
#opening{
 position:fixed;inset:0;z-index:20;
 display:flex;align-items:center;justify-content:center;text-align:center;
 background:radial-gradient(circle,#50173f,#120611 70%);
 transition:opacity .9s,visibility .9s;
}
#opening.hide{opacity:0;visibility:hidden;pointer-events:none}
.open-card{width:min(650px,90%);padding:50px 25px}
.open-heart{font-size:85px;animation:heartbeat 1.4s infinite}
@keyframes heartbeat{50%{transform:scale(1.13)}}
.open-card h1{font-size:clamp(2.8rem,9vw,5.5rem);margin:20px 0 12px}
.open-card p{color:#f5cce2;line-height:1.8;font-size:1.1rem}
.enter{
 margin-top:28px;border:1px solid #ff9dcc;background:#e94d9b;color:#fff;
 border-radius:999px;padding:16px 30px;font-size:1rem;cursor:pointer;
 box-shadow:0 0 35px #c62b7c80;transition:.25s;
}
.enter:hover{transform:scale(1.05);background:#ff69b2}
nav{
 position:fixed;top:0;left:0;right:0;z-index:10;
 display:flex;justify-content:center;gap:24px;padding:17px 10px;
 background:#10040ecc;backdrop-filter:blur(12px);
 border-bottom:1px solid #ffffff18;
}
nav a{color:#ffd5e8;text-decoration:none;font-size:.82rem}
nav a:hover{color:#ff75b8}
section{width:min(1050px,92%);margin:auto;padding:105px 0}
.hero{min-height:100vh;display:flex;align-items:center;text-align:center}
.center{width:100%}
.eyebrow{text-transform:uppercase;letter-spacing:4px;color:#ff9bcb;font-size:.75rem}
h2{font-size:clamp(2.4rem,6vw,4.5rem);margin:18px 0}
.gradient{background:linear-gradient(90deg,#fff,#ff8ec7,#ffd3e8);-webkit-background-clip:text;background-clip:text;color:transparent}
.lead{max-width:720px;margin:auto;color:#f4dce9;font-size:1.15rem;line-height:1.9}
.glass{
 background:#ffffff0b;border:1px solid #ffffff18;border-radius:30px;
 padding:42px 30px;box-shadow:0 25px 90px #0007;backdrop-filter:blur(14px);
}
.btn{
 display:inline-block;margin-top:27px;padding:14px 24px;border-radius:999px;
 border:0;background:#f05aa9;color:#fff;font-weight:bold;cursor:pointer;
 box-shadow:0 8px 30px #ef4d9a55;transition:.25s
}
.btn:hover{transform:translateY(-3px)}
.letter{font-size:1.08rem;line-height:2;color:#f8e7f0}
.letter p{margin-bottom:18px}
.signature{font-family:cursive;color:#ff9dcc;font-size:1.6rem;margin-top:25px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:18px;margin-top:30px}
.card{
 min-height:190px;padding:25px;border-radius:22px;background:#ffffff0b;
 border:1px solid #ffb4d81c;transition:.3s;cursor:pointer;
}
.card:hover{transform:translateY(-7px) rotate(-1deg);background:#ffffff12}
.card .icon{font-size:2rem}.card h3{margin:12px 0 8px;color:#ffd0e6}.card p{color:#ead0df;line-height:1.55}
.photo-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px;margin-top:30px}
.photo{
 height:310px;border:2px dashed #ff9dcc66;border-radius:24px;
 display:flex;align-items:center;justify-content:center;text-align:center;
 color:#ffc8e2;background:linear-gradient(145deg,#ffffff08,#00000018);
 position:relative;overflow:hidden;
}
.photo:before{content:"♡";font-size:7rem;position:absolute;opacity:.06}
.photo span{position:relative;line-height:1.6}
.photo img{width:100%;height:100%;object-fit:cover;border-radius:22px;position:relative;z-index:1}
.upload-box{
 text-align:center;
 margin-top:35px;
 padding:25px;
 border:2px dashed #ff9dccaa;
 border-radius:24px;
 background:#ffffff08;
}
.upload-box h3{color:#ffd0e6;margin-bottom:8px;font-size:1.3rem}
.upload-box p{color:#f4dce9;font-size:.95rem;margin-bottom:15px}
.timeline{margin-top:30px;border-left:2px solid #ff78b955;padding-left:25px}
.event{margin-bottom:28px;position:relative}
.event:before{content:"❤";position:absolute;left:-37px;top:0;color:#ff78b9}
.event h3{color:#ffb2d5;margin-bottom:7px}.event p{color:#e9cfdf;line-height:1.7}
.reveal{text-align:center;margin-top:25px}
.secret{
 display:none;margin-top:25px;padding:25px;border-radius:22px;
 background:#ff5ca922;border:1px solid #ff91c744;color:#ffe3ef;line-height:1.8;
}
.secret.show{display:block;animation:appear .5s}
@keyframes appear{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.final{text-align:center}
.final .heart{font-size:90px;animation:heartbeat 1.5s infinite}
.final h2{font-size:clamp(2.7rem,8vw,5.7rem)}
.choice{display:flex;justify-content:center;gap:14px;flex-wrap:wrap}
#answer{margin-top:22px;color:#ffc8e3;min-height:30px;font-size:1.05rem}
footer{text-align:center;padding:35px;color:#b991aa;font-size:.85rem}
.floating{position:fixed;bottom:-30px;pointer-events:none;z-index:1;animation:float 7s linear forwards}
@keyframes float{to{transform:translateY(-110vh) rotate(30deg);opacity:0}}
@media(max-width:600px){nav{gap:12px}nav a{font-size:.7rem}section{padding:85px 0}.glass{padding:30px 20px}}
</style>
</head>
<body>

<div id="opening">
  <div class="open-card">
    <div class="open-heart">💗</div>
    <div class="eyebrow">Something I made for you</div>
    <h1>Before you go...</h1>
    <p>I wanted you to see something that comes straight from my heart. Take your time and read it all. ❤️</p>
    <button class="enter" onclick="openHeart()">Open My Heart</button>
  </div>
</div>

<nav>
 <a href="#home">Home</a><a href="#letter">Letter</a><a href="#memories">Memories</a>
 <a href="#reasons">25 Things</a><a href="#future">Us</a>
</nav>

<section id="home" class="hero">
 <div class="center">
  <div class="eyebrow">A little website about you</div>
  <h2>You're still <span class="gradient">someone special</span> to me. ❤️</h2>
  <p class="lead">This isn't about pretending the past didn't happen. It's about appreciating what we had, owning my mistakes, and hoping we can create something healthier and happier.</p>
  <a class="btn" href="#letter">Start reading ↓</a>
 </div>
</section>

<section id="letter">
 <div class="glass">
  <div class="eyebrow">My honest words</div>
  <h2>Thank you for <span class="gradient">being you.</span></h2>
  <div class="letter">
   <p>I want you to know how grateful I am that you came into my life. You gave me memories and moments that mean more to me than I sometimes know how to say.</p>
   <p>I know I've made mistakes. I know there were times when I could have listened more, communicated better, and handled things differently. I'm not proud of every choice I've made, but I am willing to learn from them.</p>
   <p>I want to change for the better — not just because I want another chance with you, but because I know I need to become a better person for myself and for everyone I care about.</p>
   <p>If we ever get another chance, I don't want to repeat the same story. I want us to communicate, understand each other, be patient, laugh more, make new memories, and grow together.</p>
   <p>And if you need time, I understand. Your feelings matter to me. I just wanted you to know that my appreciation for you is real.</p>
   <div class="signature">Always grateful for you. ❤️</div>
  </div>
 </div>
</section>

<section id="memories">
 <div class="glass">
  <div class="eyebrow">Our little world</div>
  <h2>Memories I want to <span class="gradient">keep.</span></h2>
  <p class="lead">Put your actual pictures in these spaces when you're ready.</p>
  
  <div class="upload-box">
   <h3>📸 Add Your Memories</h3>
   <p>Choose photos from your phone/computer</p>
   <input type="file" id="photoUpload" accept="image/*" multiple style="display:none" onchange="handleUpload(event)">
   <button class="btn" style="margin-top:0" onclick="document.getElementById('photoUpload').click()">Upload Photos</button>
  </div>

  <div class="photo-grid" id="photoGrid">
   <div class="photo"><span>📸<br><br>YOUR PHOTO HERE<br><small>Replace this box with a picture</small></span></div>
   <div class="photo"><span>📸<br><br>YOUR PHOTO HERE<br><small>Replace this box with a picture</small></span></div>
   <div class="photo"><span>📸<br><br>YOUR PHOTO HERE<br><small>Replace this box with a picture</small></span></div>
  </div>
  <div class="timeline">
   <div class="event"><h3>One memory</h3><p>Write a short memory that always makes you smile.</p></div>
   <div class="event"><h3>Another memory</h3><p>Write something funny, cute, or meaningful that happened between you two.</p></div>
   <div class="event"><h3>A memory worth keeping</h3><p>Write about a moment you would happily experience again.</p></div>
  </div>
 </div>
</section>

<section id="reasons">
 <div class="glass">
  <div class="eyebrow">You deserve to know</div>
  <h2>25 things I <span class="gradient">love about you.</span></h2>
  <div class="cards">
   <div class="card"><div class="icon">😊</div><h3>Your smile</h3><p>It can genuinely make my whole day better.</p></div>
   <div class="card"><div class="icon">😂</div><h3>Your laugh</h3><p>Especially when you laugh at something completely random.</p></div>
   <div class="card"><div class="icon">✨</div><h3>Your beauty</h3><p>Even when you don't realize how beautiful you are.</p></div>
   <div class="card"><div class="icon">💗</div><h3>Your personality</h3><p>All the little things that make you you.</p></div>
   <div class="card"><div class="icon">🫶</div><h3>Your caring heart</h3><p>The way you can care deeply about people you love.</p></div>
   <div class="card"><div class="icon">🤍</div><h3>Understanding me</h3><p>The way you can make me feel understood.</p></div>
   <div class="card"><div class="icon">💬</div><h3>Talking to you</h3><p>Even when we're talking about absolutely nothing.</p></div>
   <div class="card"><div class="icon">🎧</div><h3>Your voice</h3><p>I could honestly listen to you for hours.</p></div>
   <div class="card"><div class="icon">👀</div><h3>Your eyes</h3><p>The way they light up when you're happy.</p></div>
   <div class="card"><div class="icon">🤣</div><h3>Your humor</h3><p>All the silly moments we've shared.</p></div>
   <div class="card"><div class="icon">🏡</div><h3>Being comfortable</h3><p>How comfortable I feel when I'm around you.</p></div>
   <div class="card"><div class="icon">📸</div><h3>Our memories</h3><p>The memories we've made and how special they are.</p></div>
   <div class="card"><div class="icon">🌷</div><h3>Making days special</h3><p>You can turn an ordinary day into something I remember.</p></div>
   <div class="card"><div class="icon">🔥</div><h3>Your passion</h3><p>How much you care about the things that matter to you.</p></div>
   <div class="card"><div class="icon">🦋</div><h3>Your strength</h3><p>Especially when things aren't easy.</p></div>
   <div class="card"><div class="icon">🥰</div><h3>Your little quirks</h3><p>The little habits that make you different from everyone else.</p></div>
   <div class="card"><div class="icon">🌱</div><h3>You challenge me</h3><p>You make me want to become a better person.</p></div>
   <div class="card"><div class="icon">❤️</div><h3>What you mean to me</h3><p>Sometimes you mean more than I know how to explain.</p></div>
   <div class="card"><div class="icon">☺️</div><h3>Your effect on me</h3><p>You can make me smile without even trying.</p></div>
   <div class="card"><div class="icon">💞</div><h3>Your attention</h3><p>It feels special whenever I have it.</p></div>
   <div class="card"><div class="icon">🤗</div><h3>How you care</h3><p>The way you care about the people close to you.</p></div>
   <div class="card"><div class="icon">🌙</div><h3>Little moments</h3><p>Every little moment I get to spend with you.</p></div>
   <div class="card"><div class="icon">📝</div><h3>Making memories</h3><p>You're someone I can make memories with, not just moments.</p></div>
   <div class="card"><div class="icon">🌸</div><h3>You are yourself</h3><p>I love you for who you are, not who I want you to be.</p></div>
   <div class="card"><div class="icon">💗</div><h3>Simply you</h3><p>Most of all, I love that you're you.</p></div>
  </div>
  <div class="reveal">
   <button class="btn" onclick="secret()">There's one more thing...</button>
   <div id="secret" class="secret">There are probably a million little things I could add here. These 25 just aren't enough to explain how much you mean to me. ❤️</div>
  </div>
 </div>
</section>

<section id="future">
 <div class="glass final">
  <div class="heart">💗</div>
  <div class="eyebrow">So here I am, asking</div>
  <h2>Can we try <span class="gradient">again?</span></h2>
  <p class="lead">I don't want perfection. I want honesty, patience, better communication, growth, laughter, and the chance to make new memories together.</p>
  <div class="choice">
   <button class="btn" onclick="yes()">Yes, let's try again ❤️</button>
   <button class="btn" onclick="time()">I need some time 💗</button>
  </div>
  <div id="answer"></div>
 </div>
</section>

<footer>Made with love, honesty, and a little bit of hope. ❤️</footer>

<script>
function openHeart(){
 document.getElementById("opening").classList.add("hide");
 window.scrollTo(0,0);
}
function secret(){document.getElementById("secret").classList.toggle("show")}
function yes(){
 document.getElementById("answer").innerHTML="Then let's take it one day at a time, do better, love better, and make new memories. ❤️";
 burst();
}
function time(){
 document.getElementById("answer").innerHTML="That's okay. Take the time you need. I respect your feelings and your space. ❤️";
}
function heart(){
 const e=document.createElement("div");e.className="floating";
 e.textContent=["❤","💕","💗","♡","✨"][Math.floor(Math.random()*5)];
 e.style.left=Math.random()*100+"vw";
 e.style.fontSize=(15+Math.random()*25)+"px";
 e.style.animationDuration=(5+Math.random()*6)+"s";
 document.body.appendChild(e);setTimeout(()=>e.remove(),12000);
}
setInterval(heart,650);
function burst(){for(let i=0;i<25;i++)setTimeout(heart,i*50)}

function handleUpload(event) {
  const files = event.target.files;
  if (!files || files.length === 0) return;
  
  const photoGrid = document.getElementById('photoGrid');
  photoGrid.innerHTML = ''; // Clear placeholder boxes
  
  Array.from(files).forEach(file => {
    const reader = new FileReader();
    reader.onload = function(e) {
      const container = document.createElement('div');
      container.className = 'photo';
      
      const img = document.createElement('img');
      img.src = e.target.result;
      
      container.appendChild(img);
      photoGrid.appendChild(container);
    };
    reader.readAsDataURL(file);
  });
}
</script>
</body>
</html>
